# URL base da API, incluindo o prefixo /api/v1.
# Sem esta variável o app deriva a URL do host do Metro em dev
# e usa a URL de produção embutida nos builds EAS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Onde mora a ponte do Pluggy Connect (public/pluggy-connect.html).
# Na web sai da propria origem; no aparelho vem daqui, com o site publicado
# como padrao quando a variavel nao existe.
EXPO_PUBLIC_WEB_BASE_URL=https://economize-web.onrender.com
