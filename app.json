{
  "expo": {
    "name": "Economize!",
    "slug": "economize",
    "scheme": "economize",
    "version": "2.3.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0E0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.n33miaz.economize"
    },
    "android": {
      "package": "com.n33miaz.economize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0E0B"
      },
      "versionCode": 15,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            },
            {
              "mimeType": "application/x-ofx"
            },
            {
              "mimeType": "application/ofx"
            },
            {
              "mimeType": "application/vnd.intu.qfx"
            },
            {
              "mimeType": "text/csv"
            },
            {
              "mimeType": "text/comma-separated-values"
            },
            {
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/icons/icon-32.png"
    },
    "plugins": [
      "expo-font",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Economize usa a câmera para fotografar os preços no carrinho de compras."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Economize usa a câmera para ler o QR code da nota fiscal e fotografar preços no mercado."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withGradleJvmArgs"
    ],
    "extra": {
      "eas": {
        "projectId": "2da28fc9-882c-45c7-bd08-c0aff25c516a"
      }
    }
  }
}
